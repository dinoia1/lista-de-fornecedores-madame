segredo.ogarimpodigital.com.br {
    encode zstd gzip
    header -Server
    request_body {
        max_size 8KB
    }
    reverse_proxy segredo-madame-app:4173 {
        header_up Host segredo.ogarimpodigital.com.br
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
